                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"restaurantName\": \"Sabiha's Pizza House\",\n  \"menuItemId\": \"{{menuItemId}}\",\n  \"menuItemName\": \"{{menuItemName}}\",\n  \"menuItemImage\": \"{{menuItemImage}}\",\n  \"menuItemPrice\": {{menuItemPrice}},\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8080/api/cart/{{userId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "RabbitMQ pre-check. Run before Place Order: cart should contain Sabiha's menu item."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cart exists before order', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('Cart contains menu item', function () { pm.expect(pm.response.text()).to.include(pm.collectionVariables.get('menuItemId')); });"
                ]
              }
            }
          ]
        },
