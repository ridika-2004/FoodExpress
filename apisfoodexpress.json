              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sabiha\",\n  \"email\": \"sabiha.customer.rabbitmq@example.com\",\n  \"phone\": \"+8801710000001\",\n  \"password\": \"Password123!\",\n  \"secretCode\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let r = {}; try { r = pm.response.json(); } catch (e) {}",
                  "const token = r.token || r.accessToken || r.jwt || r.access_token;",
                  "if (token) pm.collectionVariables.set('customerToken', token);",
                  "const u = r.user || r.data || r;",
