    {
      "name": "04. Order Service - GATEWAY /api/orders",
      "item": [
        {
          "name": "Place Order (Checkout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "http://localhost:8080/api/orders",
            "description": "RabbitMQ Test 1 trigger: after Order is saved, Order Service publishes order.created; Cart Service should auto-clear Sabiha's cart.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"customerName\": \"Sabiha\",\n  \"phone\": \"+8801710000001\",\n  \"deliveryAddress\": \"Dhaka, Bangladesh\",\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"restaurantName\": \"Sabiha's Pizza House\",\n  \"items\": [\n    {\n      \"menuItemId\": \"{{menuItemId}}\",\n      \"menuItemName\": \"{{menuItemName}}\",\n      \"menuItemImage\": \"{{menuItemImage}}\",\n      \"menuItemPrice\": {{menuItemPrice}},\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let r = {}; try { r = pm.response.json(); } catch (e) {}",
                  "const obj = r.order || r.data || r;",
                  "const id = obj.orderId || obj.id || obj._id;",
                  "if (id) pm.collectionVariables.set('orderId', id);",
                  "const total = obj.total !== undefined ? obj.total : (obj.totalAmount !== undefined ? obj.totalAmount : obj.orderTotal);",
                  "if (total !== undefined && total !== null) pm.collectionVariables.set('orderTotal', total);"
                ]
              }
            }
          ]
        },
        {
          "name": "RabbitMQ Verify 1 - Cart Auto-Cleared",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8080/api/cart/{{userId}}",
            "description": "PASS if cart is empty or removed. Do not manually clear it first.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cart cleared or removed', function () { pm.expect(pm.response.code).to.be.oneOf([200,404]); });",
                  "if (pm.response.code === 200) {",
                  "  let r={}; try{r=pm.response.json();}catch(e){}",
                  "  const obj=r.cart||r.data||r;",
                  "  const items=Array.isArray(obj)?obj:(obj.items||obj.cartItems||[]);",
                  "  pm.test('Cart has zero items', function () { pm.expect(items.length).to.eql(0); });",
                  "}"
                ]
              }
            }
          ]
        },
