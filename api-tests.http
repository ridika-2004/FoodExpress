@authHost = http://localhost:9001
@restaurantHost = http://localhost:9002

### -------------------------------------------------------------
### AUTHENTICATION SERVICE APIS (Port 9001)
### -------------------------------------------------------------

### 1. Register a new user
# @name register
POST {{authHost}}/api/auth/register
Content-Type: application/json

{
  "name": "Jane Doe",
  "email": "jane@example.com",
  "password": "Password123!",
  "role": "user",
  "phone": "+1234567890"
}

### 2. Login
# @name login
POST {{authHost}}/api/auth/login
Content-Type: application/json

{
  "email": "jane@example.com",
  "password": "Password123!"
}

### Extract token from the login response to use in protected requests
@authToken = {{login.response.body.token}}

### 3. Get Current User Profile (Protected)
GET {{authHost}}/api/auth/me
Authorization: Bearer {{authToken}}


### -------------------------------------------------------------
### RESTAURANT SERVICE APIS (Port 9002)
### -------------------------------------------------------------

### 1. Get All Restaurants
GET {{restaurantHost}}/api/restaurants
Content-Type: application/json

### 2. Get Restaurant by ID (Replace '1' with an actual restaurant ID from the request above)
GET {{restaurantHost}}/api/restaurants/1
Content-Type: application/json

### 3. Create a New Restaurant
POST {{restaurantHost}}/api/restaurants
Content-Type: application/json

{
  "name": "Burger Haven",
  "address": "456 Oak Avenue",
  "contact": "555-1234",
  "image": "https://images.unsplash.com/photo-1561758033-7e924f619f47?w=600&h=400&fit=crop",
  "cuisine": "American • Burgers",
  "rating": 4.6,
  "deliveryTime": "20-30 min",
  "deliveryFee": "₱20",
  "minOrder": "₱100",
  "isOpen": true,
  "isPromoted": true,
  "categories": ["Burger", "American"]
}

### 4. Add a Menu Item to a Restaurant (Replace '1' with an actual restaurant ID)
POST {{restaurantHost}}/api/restaurants/1/menu
Content-Type: application/json

{
  "name": "Classic Cheeseburger",
  "description": "Beef patty, cheddar, lettuce, tomato, special sauce",
  "price": 199.0,
  "category": "Burgers",
  "image": "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400&h=300&fit=crop",
  "isPopular": true,
  "isVegetarian": false
}
